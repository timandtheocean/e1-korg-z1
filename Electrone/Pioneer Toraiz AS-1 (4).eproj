{"schemaVersion":2,"id":"ahk1w52VR29aHEi2s2ae","name":"Pioneer Toraiz AS-1","description":"This preset is based on Pedro's AS1 preset and includes bidirectional communication and it parses the currently loaded patch and globals.\n\nEverything is implemented, parched and bidirectional; except the Sequencer.\n\nPress the top right button or use the **PATCH REQUEST** button.\n\nSettings ON the AS1:\n\n- midi channel: 3\n- midiParamSend: NRPN\n- MidiPAramRcv: NRPN\n- MidicontrolEnable: On\n- MidiSysexCable: MIDI\n- MIDIOut: MIDI\n- MIDIOut/Thru: Out\n\nThen Connect the AS1 To MIDI Port 1 on the E.One\n\nAlso Global parameters can be synced.\n\nDefault Midi Channel of the template is 3. \nIt can be changed in the template using the midi channel fader\n\nIn case of issues or suggestions drop me a message on the forum: \n\n\nCheers\n\n[Flyweight](https://forum.electra.one/u/Flyweight/summary)\n\n","lua":"-- This needs to reflect the preset device settings\n\npioneerAs1DeviceId = 5\n\n-- SetMidiChannel callback added in json\n-- 1026 0-16 V_GLOBAL_MIDI_CHANNEL;\nfunction setMidiChannel (control, value)\n    device = devices.get (pioneerAs1DeviceId)\n    device:setChannel (value +1)\nend\n\n\nfunction setFx1(valueObject,value) ---- hides the non used controls of effects\n  local fxNames = {\n  {0},\n  {\"Delay Time\",\"Feedback\"},\n  {\"Drive\",\"Tone\"},\n  {\"Frequency\",\"Key track 0=off\"}\n  }\n  local fxRef={1,2,3,4,5,6}\n  local message = valueObject:getMessage ()\n  local j=75\n  local name=0\n  local control ={}\n  if message:getParameterNumber() ==119 then j =62  end\n  \n   for i = 1,2 do\n    name = fxNames[fxRef[value+1]][i]\n    control = controls.get (i+j)\n    if name == 0 or name == nil then\n       control:setVisible (false)\n      else\n       control:setName (name)\n       control:setVisible (true)\n    end\n  end\nend\n\nfunction setFx2(valueObject,value) ---- hides the non used controls of effects\n  local fxNames = {\n  {0},\n  {\"Chorus Rate\",\"Depth\"},\n  {\"Phasor H Rate\",\"Depth\"},\n  {\"Phasor L Rate\",\"Depth\"},\n  {\"Phasor M Rate\",\"Depth\"}\n  }\n  local fxRef={1,2,3,4,5,6,7,8}\n  local message = valueObject:getMessage ()\n  local j=75\n  local name=0\n  local control ={}\n  if message:getParameterNumber() ==127 then j =68  end\n  \n   for i = 1,2 do\n    name = fxNames[fxRef[value+1]][i]\n    control = controls.get (i+j)\n    if name == 0 or name == nil then\n       control:setVisible (false)\n      else\n       control:setName (name)\n       control:setVisible (true)\n    end\n  end\nend","devices":[{"id":1,"name":"Generic MIDI","instrumentId":"generic-controls","port":1,"channel":1},{"id":5,"name":"Pioneer Toraiz AS-1","instrumentId":"toraizas1","port":1,"channel":3,"patch":[{"name":"Default request","request":["00","40","05","00","00","01","08","10","0E"],"responses":[{"header":["00","40","05","00","00","01","08","10","0F"],"rules":[{"type":"nrpn","parameterNumber":1024,"parameterBitPosition":0,"byte":1,"byteBitPosition":0,"bitWidth":7},{"type":"nrpn","parameterNumber":1025,"parameterBitPosition":0,"byte":0,"byteBitPosition":0,"bitWidth":7},{"type":"nrpn","parameterNumber":1045,"parameterBitPosition":0,"byte":46,"byteBitPosition":0,"bitWidth":7},{"type":"nrpn","parameterNumber":1046,"parameterBitPosition":0,"byte":47,"byteBitPosition":0,"bitWidth":7},{"type":"nrpn","parameterNumber":1035,"parameterBitPosition":0,"byte":10,"byteBitPosition":0,"bitWidth":7},{"type":"nrpn","parameterNumber":1043,"parameterBitPosition":0,"byte":13,"byteBitPosition":0,"bitWidth":7},{"type":"nrpn","parameterNumber":1044,"parameterBitPosition":0,"byte":12,"byteBitPosition":0,"bitWidth":7},{"parameterNumber":1046,"type":"nrpn","byte":43,"bitWidth":1,"byteBitPosition":5,"parameterBitPosition":0},{"parameterNumber":1046,"type":"nrpn","byte":43,"bitWidth":1,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":1046,"type":"nrpn","byte":38,"bitWidth":1,"byteBitPosition":6,"parameterBitPosition":0},{"parameterNu