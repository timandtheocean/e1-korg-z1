{"schemaVersion":2,"id":"somP8Acy7B327Ci3ja8c","name":"Korg 03R/W w/Patch parsing NewIgnis v2.0","description":"\n# KORG 03R/W NewIgnis V2.0\n\nBe aware:\n- ensure System Exclusive is enabled\n- for FX only the blue controls are parsed!\n---\nWhen changing programs, the preset will activate Prog mode, perform the preset and then enable Prog Edit mode. This is necessary, because the O3R/W only responds to parameter changes in Edit mode.\n\n\nThe preset allows you to:\n- tweak both osc layers independently or together, depending on your needs (via \"1 => 2 link \"pad)\n- use two interacting active buttons, so you  never mute both oscillators in dual osc mode.\n- simplify any EG to an ordinary ADSR\n---\nColor scheme:\n- red = OSC1 / Drum Mode only\n- yellow = OSC2 only\n- green: time based controls and names\n- white: sound level controls\n- blue: modulation controls\n- purple: program controls and specials\n\n---\n**Change log**\n- V2.0 parsed all blue FX controls (then ran out of memory)\n- V1.2 all parameters available, including FX\n- V1.1 Effects parameters are being named and valued per effect (WIP)\n- V1.0 Patches are automatically requested and parsed, but not yet the Effects. ","lua":"progNum = 0\ndeviceId = 1\ndevice = devices.get(deviceId)\ndevport = device:getPort()\nchannel = device:getChannel()\nlink = 0\n\nfxIndirectRef= {1,1,1,1,1,1,1,1,1,2,2,2,3,3,4,5,5,5,6,6,7,7,8,9,10,10,10,11,12,13,13,14,14,15,16,16,17,18,18,19,19,20,21,22,22,21,23}\n\nfxNames = {{\"reverb time\",\"pre delay (ms)\",\"earl.refl.time\",\"high damp\",\"eq low\"},{\"earl.refl.time\",\"pre delay (ms)\",\"eq low\"},{\"delay L\",\"delay R\",\"feedback\",\"high damp\",\"eq low\"},{\"delay L (ms)\",\"feedback L\",\"high damp L\",\"delay R (ms)\",\"feedback R\",\"high damp R\"},{\"delay 1\",\"delay 2\",\"feedback\",\"eq low\"},{\"delay (ms)\",\"mod speed\",\"mod depth\",\"mod  waveform\",\"eq low\"},{\"delay l\",\"delay r\",\"mod speed\",\"mod depth\",\"mod shape\",\"eq low\"},{\"delay l\",\"delay r\",\"mod speed\",\"mod depth\",\"fq split point\"},{\"mod depth\",\"eq low\"},{\"delay\",\"mod depth\",\"mod speed\",\"resonance\",\"eq low\"},{\"blend\",\"emphatic point\",\"eq low\"},{\"density\",\"hot spot\",\"stereo width\",\"delay time\",\"eq low\"},{\"drive (edge)\",\"hot spot\",\"resonance\",\"eq low\",\"eq high\",\"out level\"},{\"manual\",\"mod speed\",\"mod depth\",\"feedback\",\"waveform\"},{\"vibrato depth\",\"acceleration\",\"slow speed\",\"fast speed\"},{\"waveform\",\"mod shape\",\"mod speed\",\"lfo depth\",\"eq low\"},{\"freq low\",\"eq LOW\",\"freq mid\",\"eq mid\",\"width mid\",\"freq high\",\"eq high\"},{\"ch. delay (ms)\",\"ch.feedback\",\"ch.mod speed\",\"ch.mod depth\",\"delay\",\"feedback\"},{\"delay (ms)\",\"feedback\",\"high damp\",\"rev time\",\"pre delay (ms)\",\"high damp\"},{\"delay (ms)\",\"feedback\",\"high damp\",\"mod speed\",\"mod depth\",\"waveform\"},{\"delay (ms)\",\"feedback\",\"high damp\",\"mod speed\",\"mod depth\",\"feedback\"},{\"delay (ms)\",\"feedback\",\"drive (edge)\",\"hot spot\",\"resonance\",\"level\"},{\"delay (ms)\",\"feedback\",\"acceleration\",\"slow speed\",\"fast speed\"}}\n\nctrlMin={{0},{0},{0,0,-99},{0,-99,0,0,-99},{0,0,-99,},{0},{0,0,1,0,-21},{0,0,1},{0},{0,0,1,-99},{-99,1},{1,1,0, 1},{1},{0,0,0,-99},{0,1,1,1},{0, -99},{0},{0, -99, 1, 0,0,-99},{0, -99},{0,-99},{0,-99,0,0,0,-99},{0,-99,1,0,1,1},{0,-99,0,0,0,-99},{0,-99,1,1,1}}\n\nctrlMax={{99,200},{70,200},{500,500},{500,99,99,500},{500,500},{200,216,99, 1},{250,250,99, 99, 20},{500,500,99, 99, 18},{99},{200},{99, 10},{99, 20},{111},{99, 200, 99, 99, 1},{15, 15},{1, 99, 200},{29, 12, 99, 12, 99, 29},{50, 99, 99, 99, 225},{500, 99, 99, 97, 150},{500, 99, 99, 99, 150, 1},{500, 99, 99, 99, 150},{500, 99, 111},{500, 99, 15}}\n\n-- sysEx and generic functions ---------------------------------------\n\nfunction getChannelByte(device) \n  return (0x30 + (channel - 1))\nend\n\nfunction getMSB8bit(deviceObject, value) \n  if value >= 128  then\n     return 127\n else\n   return 0\n  end\nend\n\nfunction getMSB7bit(deviceObject, value)\n  if value >= 64 then\n     return 127\n  else\n   return 0\n  end\nend\n\nfunction linkOnOff(valueObject, value)\n  link= value\nend\n\n-- formatting functions -----------------------------\n\nnotes = {\n    \"C%d\",\n    \"C%d#\",\n    \"D%d\",\n    \"D%d#\",\n    \"E%d\",\n    \"F%d\",\n    \"F%d#\",\n    \"G%d\",\n    \"G%d#\",\n    \"A%d\",\n    \"A%d#\",\n    \"B%d\"\n}\n\nfunction displayNotes (valueObject, value)\n  return (string.format(notes[math.fmod(value, 12) +1], (value// 12)-1))\nend\n\nfunction displayChar (valueObject, value)\n  return string.char(value)\nend\n\n-- other functions -----------------------------------------------------------------------\n\nfunction changeChar (valueObject, value)\n  local patchName = \"\"\n  for i = 0, 9 do\n        patchName = patchName .. string.char (parameterMap.get (deviceId, PT_SYSEX, 200+i))\n   end\n  print(\"Patch Name = \"..patchName )\n  for i=1,6 do\n    control= controls.get (36*i-4)\n    control:setName (patchName)\n  end\nend\n\nfunction resetName(valueObject, value)\n  for i=1,6 do\n   control= controls.get (36*i-4)\n   control:setName (\"select program\")\n  end\nend\n\nfunction linkPar(valueObject, value) \n    if link== 0 then return end\n    local default= valueObject:getDefault ()\n    local message = valueObject:getMessage ()\n    local parameterNumber = message:getParameterNumber ()\n    --print (\"original value = \" ..value)\n    if value < 0 then value = value + 256 end\n    if default > 99 then value = (value + default) % 128 end\n    --print (\"transmitted value = \" ..value)\n    parameterMap.set (deviceId, PT_SYSEX, parameterNumber+65,value)\n    parameterMap.send (deviceId, PT_SYSEX, parameterNumber+65)\nend\n\nfunction mute1(ValueObject, value) \n   if parameterMap.get(deviceId, PT_SYSEX, 0) ~=1 then\n     return\n   end\n   if value==1 then parameterMap.send (deviceId, PT_SYSEX, 25) \n   else\n   midi.sendSysex (devport , {0x42, getChannelByte(device), 0x30, 0x41, 25, 0, 0, 0})\n   parameterMap.set (deviceId, PT_VIRTUAL, 1124,1)\n   parameterMap.send (deviceId, PT_SYSEX, 90) \n   end\nend\n\nfunction mute2(ValueObject, value) \n   if parameterMap.get(deviceId, PT_SYSEX, 0) ~=1 then\n     return\n   end\n   if value==1 then parameterMap.send (deviceId, PT_SYSEX, 90) \n   else\n   midi.sendSysex (devport , {0x42, getChannelByte(device), 0x30, 0x41, 90, 0, 0, 0})\n   parameterMap.set (deviceId, PT_VIRTUAL, 1123,1)\n   parameterMap.send (deviceId, PT_SYSEX, 25) \n   end\nend\n\n---- prog and bank select ---------------------------------------------------------------------------\n\nfunction selectPgm(ValueObject, value) \n   if value==0 then return end\n   midi.sendSysex (devport, {0x42, getChannelByte(device), 0x30, 0x4E,0x02,0x00}) \n      local message = ValueObject:getMessage ()\n      local messageValue = message:getValue ()\n      progNum=parameterMap.get (deviceId, PT_VIRTUAL, 503)\n      local bankLSB=parameterMap.get (deviceId, PT_VIRTUAL, 502)\n      local bankMSB = 0\n      local max = 99\n      local min = 0\n      local offset=0\n   if bankLSB== 4 then\n     messageValue=0\n     bankMSB = 0x3E\n     bankLSB=0\n   end\n   if bankLSB==1 then\n      max=128\n      min=1\n      progNum=math.max(progNum,min)\n     offset=1\n   end\n   if messageValue ==2 then progNum=math.min(progNum+1,max) end\n   if messageValue ==-1 then progNum=math.max(progNum-1,min) end\n   parameterMap.set (deviceId, PT_VIRTUAL, 503,progNum)\n   parameterMap.set (deviceId, PT_CC7, 64,0)\n   parameterMap.set (deviceId, PT_CC7, 91,127)\n   parameterMap.set (deviceId, PT_CC7, 92,127)\n   midi.sendControlChange(devport , channel , 32, bankLSB)\n   midi.sendControlChange(devport , channel , 0, bankMSB)\n   midi.sendProgramChange (devport , channel , progNum-offset)\n   midi.sendSysex (devport, {0x42, getChannelByte(device), 0x30, 0x10}) \n   enableTimer(170)\nend\n\nfunction selectBank(ValueObject, value) \n   if value<=3 then return end\n   progNum=math.min(parameterMap.get (deviceId, PT_VIRTUAL, 503),127)\n   bankMSB = 0x3E\n   bankLSB=0\n   parameterMap.set (deviceId, PT_VIRTUAL, 503,progNum)\n   midi.sendControlChange(devport , channel , 32, bankLSB)\n   midi.sendControlChange(devport , channel , 0, bankMSB)\n   midi.sendProgramChange (devport , channel , progNum)\n   midi.sendSysex (devport, {0x42, getChannelByte(device), 0x30, 0x10}) \n   enableTimer(170)\nend\n\nfunction distriBit(paramNum) -- distibute the bits of the temp EG TIME PT_VIRTUAL to their 4 selection lists PT_SYSEX\n  local pair =0\n  local value =parameterMap.get (deviceId, PT_VIRTUAL, paramNum)\n  for i=0,3 do\n     pair = value % 4\n     if pair <= 1 then do parameterMap.set (deviceId, PT_SYSEX , paramNum-1100+i,0)  end -- 0\n       elseif pair == 2 then do parameterMap.set (deviceId, PT_SYSEX , paramNum-1100+i,1)  end -- +\n       else do parameterMap.set (deviceId, PT_SYSEX , paramNum-1100+i,127)  end  -- -\n     end\n    value = math.floor(value/4)\n  end\nend\n\nfunction enableTimer(period) \n   myCounter = 0\n   timer.setPeriod(period)\n   timer.enable()\nend\n\nfunction timer.onTick()\n   if myCounter ==1 then \n     parameterMap.set (deviceId, PT_SYSEX, 1122,3) -- go into edit mode\n     midi.sendSysex (devport, {0x42, getChannelByte(device), 0x30, 0x4E,0x03,0x00}) \n  end\n   if myCounter ==3 then \n     timer.disable()\n     print (\"Processing parsed data. Data is parsed, correct?\")\n     oscMode(nil,parameterMap.get (deviceId, PT_SYSEX, 0)) -- osc mode\n     distriBit(1143)\n     distriBit(1151)\n     distriBit(1164)\n     distriBit(1172)\n     distriBit(1208)\n     distriBit(1216)\n     distriBit(1229)\n     distriBit(1237)\n  changeChar ({}, 0)\n  end\n  myCounter = myCounter + 1\nend\n\n--- hiding functions ----------------------------------------------------------------------------------------\n\nfunction oscMode(ValueObject, value) \n  local ctrl2hide= {1,2,3,4,5,6,181,187,188,189,190,191,192,216,7,8,9,10,11,12,13,14,15,28,34}\n  for i= 1,25 do\n    control = controls.get (ctrl2hide[i])\n     if (value==0 and i <=7) or (value==1 and i<= 23) or (value==2 and i >=24) then control:setVisible(true) else control:setVisible(false) end\n  end\n   parameterMap.set (deviceId, PT_VIRTUAL, 1123,1)\n   if value == 1 then parameterMap.set (deviceId, PT_VIRTUAL, 1124,1) else parameterMap.set (deviceId, PT_VIRTUAL, 1124,0) end\nend\n\nfunction adsrMode(ValueObject, value) -- allows each of the 4 EG to become simple ADSR\n    local type = 4\n    local message = ValueObject:getMessage ()\n    local parNum = message:getParameterNumber () -1300\n    local ctrl2hide={}\n    local bool2Hide = false\n    if value==0 then bool2Hide=true end\n    --local messageValue = message:getValue ()\n    if parNum+1300 == 1333 then\n       ctrl2hide= {45,46,47,48}\n    elseif parNum+1300==1355 then\n       ctrl2hide= {81,82,83}\n       type = 3\n    elseif parNum+1300==1398 then\n       ctrl2hide= {261,262,263,264}\n    elseif parNum+1300==1420 then\n       ctrl2hide= {297,298,299}\n       type = 3\n   end\n    local parNum2c={parNum+1,parNum+7,parNum+3,parNum+5}\n    for i= 1,type do\n       control = controls.get (ctrl2hide[i])\n       control:setVisible (bool2Hide)\n    end\n   if value==0 then return end\n    for i= 1,type-2 do\n      parameterMap.set (deviceId, PT_SYSEX, parNum2c[i],0)\n      parameterMap.send (deviceId, PT_SYSEX, parNum2c[i])  \n    end\n    parameterMap.set (deviceId, PT_SYSEX, parNum2c[3],parameterMap.get (deviceId, PT_SYSEX, parNum2c[4]))\n    parameterMap.send (deviceId, PT_SYSEX, parNum2c[3])  \nend\n\n\nfunction adsrCheck(ValueObject, value) -- checks if breakpoint must follow sustain\n    local message = ValueObject:getMessage ()\n    local parNum = message:getParameterNumber ()\n    local toCheck = parameterMap.get (deviceId, PT_VIRTUAL, parNum+1300-5)\n    if toCheck==0 then return end\n    if value < 0 then value = value + 256 end\n    parameterMap.set (deviceId, PT_SYSEX, parNum-2,value)\n    parameterMap.send (deviceId, PT_SYSEX, parNum-2)  \nend\n\n\n-- fx management functions ----------------------------------------------------------------------------------------\n\nfunction setFx(valueObject,value) ---- hides the non used controls of effects\n  local fx2 = 0\n  local message = valueObject:getMessage ()\n  if message:getParameterNumber () == 152 then fx2 = 12 end\n  local visible = true\n  local ctrlValue= {}\n  local name=0\n  local previousName=0\n  local index =0\n  if value == 0 then visible=false end\n  for i = 115+fx2,116+fx2 do\n       control = controls.get (i)\n       control:setVisible (visible )\n  end\n  if value ~= 0 then index =fxIndirectRef[value] end\n  for i = 1,7 do\n    if i <=3 then j=110+fx2+i else j= 113+fx2+i end\n    control = controls.get (j)\n    if value~=0 then name = fxNames[index][i] end\n    if previousName == \"eq low\" then name = \"eq high\" end\n    if value == 0 or name == 0 or name == nil then control:setVisible (false)\n      else\n       control:setName (name)\n       if string.sub(name,1,2) == \"eq\" then control:setColor(GREEN)\n         elseif (index==3 or index==7 or index==8) and i==1 then control:setColor(WHITE) \n         elseif (index==3 or index==7 or index==8) and i==2 then control:setColor(RED) \n         elseif (index==22 or index==23) and i==3  then control:setColor(RED)\n         elseif (index==4 or (index>=19 and index<=23)) and i>=1 and i <=3 then control:setColor(WHITE) \n         elseif (index==4 or (index>=19 and index<=23)) and i>=4 and i <=6  then control:setColor(RED)\n         elseif index==18 and i>=5 and i <=6  then control:setColor(GREEN)\n         else control:setColor(PURPLE)\n       end\n       control:setVisible (true)\n       previousName = name\n       ctrlValue = control:getValue (\"\")\n       if ctrlMin[index][i]~=nil then ctrlValue:setMin (ctrlMin[index][i]) \n          elseif string.sub(name,1,2) == \"eq\" then ctrlValue:setMin (-12)\n          else ctrlValue:setMin (0) end\n       if ctrlMax[index][i]~=nil then ctrlValue:setMax (ctrlMax[index][i])\n          elseif string.sub(name,1,2) == \"eq\" then ctrlValue:setMax (12)\n          else ctrlValue:setMax (99) end\n    end\n  end\n  if index == 7 or index ==8 or index==10 or index==14 or index==15 then name = \"mod speed\"\n     elseif index ==13 or index==22 then name = \"hot spot wah\"\n     elseif index ==17 then name = \"freq mid\"\n     else name = \"dry<->wet mod\"\n  end\n  control = controls.get (116+fx2)\n  control:setName (name)\nend\n\nfunction sendFx(valueObject,value)\n  local message = valueObject:getMessage ()\n  local parNum = message:getParameterNumber ()\n  local byte1 = value\n  local byte2 = 0\n  if value < 0 then\n    byte1 = value+128\n    byte2 = 127\n elseif  value >127 then \n    byte1 = value%128\n    byte2 = math.floor(value/128)\n end\n midi.sendSysex (devport, {0x42, getChannelByte(device), 0x30, 0x41,parNum-128,0x01,byte1,byte2})\nend\n\n","devices":[{"id":1,"name":"03R/W","port":1,"channel":3,"patch":[{"request":["42",{"type":"function","name":"getChannelByte"},"30","10"],"responses":[{"header":["42","32","30","40"],"rules":[{"parameterNumber":200,"type":"sysex","byte":1,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":201,"type":"sysex","byte":2,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":202,"type":"sysex","byte":3,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":203,"type":"sysex","byte":4,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":204,"type":"sysex","byte":5,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":205,"type":"sysex","byte":6,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":206,"type":"sysex","byte":7,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":207,"type":"sysex","byte":9,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":208,"type":"sysex","byte":10,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":209,"type":"sysex","byte":11,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":0,"type":"sysex","byte":12,"bitWidth":2,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":1,"type":"sysex","byte":13,"bitWidth":1,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":2,"type":"sysex","byte":13,"bitWidth":1,"byteBitPosition":1,"parameterBitPosition":0},{"parameterNumber":24,"type":"sysex","byte":14,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":24,"type":"sysex","byte":8,"bitWidth":1,"byteBitPosition":5,"parameterBitPosition":7},{"parameterNumber":26,"type":"sysex","byte":17,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":89,"type":"sysex","byte":18,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":89,"type":"sysex","byte":16,"bitWidth":1,"byteBitPosition":1,"parameterBitPosition":7},{"parameterNumber":91,"type":"sysex","byte":20,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":86,"type":"sysex","byte":21,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":87,"type":"sysex","byte":22,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":88,"type":"sysex","byte":23,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":3,"type":"sysex","byte":25,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":3,"type":"sysex","byte":24,"bitWidth":1,"byteBitPosition":0,"parameterBitPosition":7},{"parameterNumber":5,"type":"sysex","byte":27,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":5,"type":"sysex","byte":24,"bitWidth":1,"byteBitPosition":2,"parameterBitPosition":7},{"parameterNumber":8,"type":"sysex","byte":30,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":8,"type":"sysex","byte":24,"bitWidth":1,"byteBitPosition":5,"parameterBitPosition":7},{"parameterNumber":9,"type":"sysex","byte":33,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":9,"type":"sysex","byte":32,"bitWidth":1,"byteBitPosition":0,"parameterBitPosition":7},{"parameterNumber":10,"type":"sysex","byte":31,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":10,"type":"sysex","byte":24,"bitWidth":1,"byteBitPosition":6,"parameterBitPosition":7},{"parameterNumber":4,"type":"sysex","byte":26,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":6,"type":"sysex","byte":28,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":7,"type":"sysex","byte":29,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":11,"type":"sysex","byte":34,"bitWidth":3,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":15,"type":"sysex","byte":34,"bitWidth":2,"byteBitPosition":5,"parameterBitPosition":0},{"parameterNumber":16,"type":"sysex","byte":32,"bitWidth":1,"byteBitPosition":1,"parameterBitPosition":0},{"parameterNumber":12,"type":"sysex","byte":35,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":14,"type":"sysex","byte":36,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":13,"type":"sysex","byte":37,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":17,"type":"sysex","byte":38,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":18,"type":"sysex","byte":39,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":19,"type":"sysex","byte":41,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":20,"type":"sysex","byte":42,"bitWidth":7,"byteBitPosition":0,"parameterBitPosition":0},{"parameterNumber":22,"type