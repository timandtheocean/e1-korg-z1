{"schemaVersion":2,"id":"lXlZasmHp5yZf2oaUofs","name":"Yamaha TX7 V2.1","description":"#  YAMAHA TX7 V2.1 \nby NewIgnis (based on Martin's work)\n\n![Yamaha TX7](data:image/jpeg;base64,)\n\nThe TX7 in-corporates a 32 voice memory as well as 32 programmable function memories containing the function data for all 32 voices. There are also 32 function memories available primarily for use with the Yamaha DX7 (but these are not adressed in this preset). \n\n# TX7 setup\n\n- MIDI mode Ctl.Chng.Rcv must be ON\n\n# Notes\n- Operator on/off switches are for editing only, they are not stored.\n- Have some **patience** when performing a program change on the E1. It may take some time before it performs all the hides, changes the operator colors and displays the patch name.\n\n\n# Operator colors reflect the algorithm\nWith every algorithm, colors may change on the 6 operators:\n\n- The operator Output Level is in WHITE if it is an audio output \n- The operator Output Level inherits the color of the controlled operator, if it is not an audio output. The Output Level color thus indicates the controlled operator.\n- If one output level is controlling more than one operator, then all those operators will share the same color\n- The operator name will show if it has feedback and how much\n\n# About control hiding\nHiding is used to make the patch easier to read.\n- Disabling an operator will hide its parameters\n- Key Curves are hidden if their Key Depth is not set\n\n# Manuals & Info\n- [Owners manual](https://www.deepsonic.ch/deep/docs_manuals/yamaha_tx7_manual.pdf) - includes full description of the MIDI implementation\n- [Vintage synths review](http://www.vintagesynth.com/yamaha/tx7.php) - a brief review of the synth on the Vintage Synth Explorer\n","lua":"deviceId = 1 -- the device ID used in the E1 preset\ndevice = devices.get(deviceId)\ndevPort = device:getPort()\nchannel = device:getChannel()\n\n\n-- returns a byte that TX7 uses to identify the MIDI channel\n-- for a parameter change message\nfunction getChannelByte(device)\n  return (0x10 + (device:getChannel() - 1))\nend\n\n-- returns a byte that TX7 uses to identify the MIDI channel\nfunction getRequestByte(device)\n  return (0x20 + (device:getChannel() - 1))\nend\n\n-- display functions ---------------------------------------------------------------------\n\nnotes = {\n    \"C%d\",\n    \"C%d#\",\n    \"D%d\",\n    \"D%d#\",\n    \"E%d\",\n    \"F%d\",\n    \"F%d#\",\n    \"G%d\",\n    \"G%d#\",\n    \"A%d\",\n    \"A%d#\",\n    \"B%d\"\n}\n\nopsCtrl= {12,18,24,30,48,54,60,72,78,84,90,96,102}\nopsCtrl2= {6,12,18,24,30,42,48,54,60,72,78,84,90,96,102}\n\n\nfunction displayNotes(valueObject, value)\n  return (string.format(notes[math.fmod(value+9, 12) +1], ((value-3)// 12)))\nend\n\nfunction displayNotes2(valueObject, value)\n  return (string.format(notes[math.fmod(value, 12) +1], ((value-24)// 12)))\nend\n\nfunction convertToFractions (valueObject, value)\n    return (string.format(\"%.2f\", value /100))\nend\n\nfunction displayChar (valueObject, value)\n  return string.char(value)\nend\n\nfunction changeChar (valueObject, value)\n  local patchName = \"\"\n  for i = 145, 154 do\n        patchName = patchName .. string.char (parameterMap.get (deviceId, PT_SYSEX, i))\n   end\n  print(\"Patch Name = \"..patchName )\n  control= controls.get (36*2-1)\n  control:setName (patchName)\n  control= controls.get (36*5-1)\n  control:setName (patchName)\nend\n\nfunction resetName(valueObject, value)\n    control= controls.get (36*2-1)\n    control:setName (\"patch request\")\n    control= controls.get (36*5-1)\n    control:setName (\"patch request\")\nend\n\n---------------------------------------------------------- show and hide -----------------------\n\nfunction hidePatchReq(valueObject,value) ---- hides patch request when in IND mode\n local bool=true\n  if value==1 then bool=false end\n  for i = 33, 36 do\n    for j = 2, 5, 3 do\n         local control = controls.get (36*(j-1)+i )\n         control:setVisible (bool)\n     end\n  end\n  if value==0 then\n     midi.sendSysex (devPort , { 0x43,  0x20,  0x00})  \n     for  i=1,950000 do end\n     changeChar()\n  end\nend\n\nfunction hideOps(valueObject,value,operatorNum ) ---- hides the non used operator parameters\n  local message = valueObject:getMessage ()\n  local bool=true\n  if value==0 then bool=false end\n  if operatorNum==nil then\n     local paramNum = message:getParameterNumber()\n     if paramNum > 300 then paramNum = paramNum -300 end\n     operatorNum = 6-(paramNum -16)/21\n  end\n  for i = 1,13 do\n     local control = controls.get (operatorNum + opsCtrl[i])\n     control:setVisible (bool)\n  end\n   -- print (\"-------------Processed operatorNum : \" .. operatorNum)\nend\n\nfunction hideKLC(valueObject,value,operatorNum ) ---- hides the non used Key Left Curve choice\n  local message = valueObject:getMessage ()\n  local bool=true\n  if value==0 then bool=false end\n  if operatorNum==nil then\n     local paramNum = message:getParameterNumber()\n     operatorNum = 6-(paramNum -9)/21\n  end\n  local control = controls.get (operatorNum + 72)\n  control:setVisible (bool)\nend\n\nfunction hideKRC(valueObject,value,operatorNum ) ---- hides the non used Key Right Curve choice\n  local message = valueObject:getMessage ()\n  local bool=true\n  if value==0 then bool=false end\n  if operatorNum==nil then\n     local paramNum = message:getParameterNumber()\n     operatorNum = 6-(paramNum -10)/21\n  end\n  local control = controls.get (operatorNum + 78)\n  control:setVisible (bool)\nend\n\n\nfunction hideRange (valueObject,value) ---- hides the pitchBend range when steps are activated\n  local bool=false\n  if value==0 then bool=true end\n  local control = controls.get (36*3 + 7)\n  control:setVisible (bool)\nend\n\n\nfunction colorAlgo(valueObject,value) ---- Set colors according to algorithm\n local color1=RED\n local color3= ORANGE\n local color4 = GREEN\n local color5=PURPLE\n local colorLvl2= WHITE\n local colorLvl3= WHITE\n local colorLvl4= WHITE\n local colorLvl5= WHITE\n local colorLvl6= WHITE\n\n value = value+1\n if value == 20 or value == 21 then color1 = BLUE end\n  if value == 19 or (value >= 21 and value <= 25) then color4 = PURPLE end\n  if value == 22 or value == 24 then color3 = PURPLE  end\n  for i = 1,15 do\n        local control = controls.get (1+ opsCtrl2[i])\n        control:setColor (color1)\n        control = controls.get (3+ opsCtrl2[i])\n        control:setColor (color3)\n        control = controls.get (4+ opsCtrl2[i])\n        control:setColor (color4)\n     end\n  if value == 22 or value == 28 or (value >= 1 and value <= 19) then colorLvl2= RED end --- 2 on top of 1\n  if (value >= 16 and value <= 18) then colorLvl3= RED end --- 3 on top of 1\n  if value == 3 or value == 4 or value == 10 or value == 11 or (value >= 19 and value <= 21) or value == 23 or value == 26 or value == 27 then colorLvl3= BLUE end --- 3 on top of 2\n  if value == 1 or value == 2 or (value >= 5 and value <= 9) or (value >= 12 and value <= 17) or (value >= 28 and value <= 30) then colorLvl4= ORANGE end --- 4 on top of 3\n  if value == 18 then colorLvl4= RED end --- 4 on top of 1\n  if  (value >= 1 and value <= 4) or (value >= 10 and value <= 11) or (value >= 14 and value <= 15) or value == 18 or value == 20  or (value >= 26 and value <= 28) or value == 30  then colorLvl5= GREEN end --- 5 on top of 4\n  if  (value >= 7 and value <= 9) or (value >= 12 and value <= 13)  then colorLvl5= ORANGE end --- 5 on top of 3\n  if  value == 16 or value == 17  then colorLvl5= RED end --- 5 on top of 1\n  if  (value >= 1 and value <= 9) or (value >= 16 and value <= 19) or (value >= 21 and value <= 25) or value == 29 or value == 31  then colorLvl6= PURPLE end --- 6 on top of 5\n  if  (value >= 10 and value <= 11) or (value >= 14 and value <= 15)  or value == 20 or value == 26  or value == 27  then colorLvl6= GREEN end --- 6 on top of 4\n  if  value == 12 or value == 13 then colorLvl6= ORANGE end --- 6 on top of 3\n\n  for i = 0,1 do\n        local control = controls.get (2+ 36*i)\n        control:setColor (colorLvl2)\n        local control = controls.get (3+ 36*i)\n        control:setColor (colorLvl3)\n        local control = controls.get (4+ 36*i)\n        control:setColor (colorLvl4)\n        local control = controls.get (5+ 36*i)\n        control:setColor (colorLvl5)\n        local control = controls.get (6+ 36*i)\n        control:setColor (colorLvl6)\n     end\n\n  nameFb(valueObject,nil,value)\n\nend\n\nfunction nameFb(valueObject,feedBack,value)----------------display operator with feedback value\n  if feedBack==nil then feedBack=parameterMap.get (deviceId, PT_SYSEX, 135) end\n  if value       ==nil then  value      =parameterMap.get (deviceId, PT_SYSEX, 134) + 1 end\n  local fbName = 6\n  if value == 2 or value == 9 or value == 12 or value == 15 or value == 17  then fbName= 2\n    elseif value == 10  or value == 18 or value == 20 or value == 21 or value == 27 then fbName= 3\n    elseif value == 8  then fbName= 4\n    elseif value == 28  or value == 30 then fbName= 5\n    elseif value == 4  then fbName= \"4>6\" \n    elseif value == 6  then fbName= \"5>6\" \n  end\n  local control = controls.get (36*4+2)\n  control:setName (\"Op \"..fbName..\" feedback\")\n \nif fbName== \"4>6\" or fbName== \"5>6\" then fbName =6 end\n for i = 1,6 do\n    local control = controls.get (6+i)\n    if i == fbName then control:setName (\"Op. \"..i..\" feedbck \"..string.format(\"%.0f\", feedBack)) else control:setName (\"Op. \"..i) end\n    local control = controls.get (36+6+i)\n    if i == fbName then control:setName (\"Op. \"..i..\" feedbck \"..string.format(\"%.0f\", feedBack)) else control:setName (\"Op. \"..i) end\n  end\nend\n\n\n\n---------------------------------------------- DUMP REQUESTS --------------------------------------\n\n\nfunction requestIt(valueObject, value) ---- selects a patch and requests its SysEx patch settings\n    if value==0 then return end\n    resetName()\n    local message = valueObject:getMessage ()\n    local paramNum = message:getParameterNumber ()\n    print (\"Parameter Number: \" .. paramNum ) \n    local messageValue = message:getValue ()\n    print (\"message value: \" .. messageValue )\n    --local bankLSB = parameterMap.get (deviceId, PT_VIRTUAL, paramNum -messageValue -1)\n    local progNum = parameterMap.get (deviceId, PT_VIRTUAL, paramNum -messageValue ) + messageValue - 2\n    if progNum == 32 then progNum= 0 end\n    if progNum == -1   then progNum=31 end\n    parameterMap.set (deviceId, PT_VIRTUAL, paramNum -messageValue,progNum)\n    --print (\"bankLSB : \" .. bankLSB)\n    print (\"progNum : \" .. progNum )\n    --print (string.format(\"selecting patch: Bank = %d, Prog = %d\", bankLSB, progNum))\n    -- midi.sendControlChange(devPort , channel , 32, bankLSB)\n   midi.sendProgramChange(devPort , channel , progNum)\n\n   midi.sendSysex (devPort , { 0x43,  0x20,  0x00})  \n   midi.sendSysex (devPort , { 0x43,  0x20,  0x01})  \n   for i = 1,6 do          -- reset operators to on\n      parameterMap.set (deviceId, PT_SYSEX, 421-21*(i-1),1)\n   end\n   for  i=1,750000 do end -- give time to parse\n   colorAlgo(valueObject,parameterMap.get (deviceId, PT_SYSEX, 134 ))\n   for i = 1,6 do\n    hideOps(valueObject,parameterMap.get (deviceId, PT_SYSEX, 16+(6-i)*21 ),i)\n    hideKLC(valueObject,parameterMap.get (deviceId, PT_SYSEX, 9 +(6-i)*21 ),i)\n    hideKRC(valueObject,parameterMap.get (deviceId, PT_SYSEX, 10 +(6-i)*21 ),i)\n  end\n  hideRange(valueObject,parameterMap.get (deviceId, PT_SYSEX, 266))\n  changeChar()\nend\n","devices":[{"id":1,"name":"Yamaha TX7","port":1,"channel":1,"patch":[{"request":["43",{"type":"function","name":"getRequestByte"},"00"],"responses":[{"header":["43","00","00","01","1B"],"rules":[{"id":136,"pPos":0,"byte":136,"bPos":0,"size":1,"msg":"sysex"},{"id":144,"pPos":0,"byte":144,"bPos":0,"size":6,"msg":"sysex"},{"id":143,"pPos":0,"byte":143,"bPos":0,"size":3,"msg":"sysex"},{"id":126,"pPos":0,"byte":126,"bPos":0,"size":7,"msg":"sysex"},{"id":127,"pPos":0,"byte":127,"bPos":0,"size":7,"msg":"sysex"},{"id":128,"pPos":0,"byte":128,"bPos":0,"size":7,"msg":"sysex"},{"id":129,"pPos":0,"byte":129,"bPos":0,"size":7,"msg":"sysex"},{"id":130,"pPos":0,"byte":130,"bPos":0,"size":7,"msg":"sysex"},{"id":131,"pPos":0,"byte":131,"bPos":0,"size":7,"msg":"sysex"},{"id":132,"pPos":0,"byte":132,"bPos":0,"size":7,"msg":"sysex"},{"id":133,"pPos":0,"byte":133,"bPos":0,"size":7,"msg":"sysex"},{"id":137,"pPos":0,"byte":137,"bPos":0,"size":7,"msg":"sysex"},{"id":138,"pPos":0,"byte":138,"bPos":0,"size":7,"msg":"sysex"},{"id":139,"pPos":0,"byte":139,"bPos":0,"size":7,"msg":"sysex"},{"id":140,"pPos":0,"byte":140,"bPos":0,"size":7,"msg":"sysex"},{"id":141,"pPos":0,"byte":141,"bPos":0,"size":1,"msg":"sysex"},{"id":142,"pPos":0,"byte":142,"bPos":0,"size":3,"msg":"sysex"},{"id":135,"pPos":0,"byte":135,"bPos":0,"size":3,"msg":"sysex"},{"id":113,"pPos":0,"byte":113,"bPos":0,"size":7,"msg":"sysex"},{"id":114,"pPos":0,"byte":114,"bPos":0,"size":7,"msg":"sysex"},{"id":115,"pPos":0,"byte":115,"bPos":0,"size":7,"msg":"sysex"},{"id":116,"pPos":0,"byte":116,"bPos":0,"size":2,"msg":"sysex"},{"id":117,"pPos":0,"byte":117,"bPos":0,"size":2,"msg":"sysex"},{"id":118,"pPos":0,"byte":118,"bPos":0,"size":3,"msg":"sysex"},{"id":119,"pPos":0,"byte":119,"bPos":0,"size":2,"msg":"sysex"},{"id":120,"pPos":0,"byte":120,"bPos":0,"size":3,"msg":"sysex"},{"id":92,"pPos":0,"byte":92,"bPos":0,"size":7,"msg":"sysex"},{"id":93,"pPos":0,"byte":93,"bPos":0,"size":7,"msg":"sysex"},{"id":94,"pPos":0,"byte":94,"bPos":0,"size":7,"msg":"sysex"},{"id":95,"pPos":0,"byte":95,"bPos":0,"size":2,"msg":"sysex"},{"id":96,"pPos":0,"byte":96,"bPos":0,"size":2,"msg":"sysex"},{"id":97,"pPos":0,"byte":97,"bPos":0,"size":3,"msg":"sysex"},{"id":98,"pPos":0,"byte":98,"bPos":0,"size":2,"msg":"sysex"},{"id":99,"pPos":0,"byte":99,"bPos":0,"size":3,"msg":"sysex"},{"id":71,"pPos":0,"byte":71,"bPos":0,"size":7,"msg":"sysex"},{"id":72,"pPos":0,"byte":72,"bPos":0,"size":7,"msg":"sysex"},{"id":73,"pPos":0,"byte":73,"bPos":0,"size":7,"msg":"sysex"},{"id":74,"pPos":0,"byte":74,"bPos":0,"size":2,"msg":"sysex"},{"id":75,"pPos":0,"byte":75,"bPos":0,"size":2,"msg":"sysex"},{"id":76,"pPos":0,"byte":76,"bPos":0,"size":3,"msg":"sysex"},{"id":77,"pPos":0,"byte":77,"bPos":0,"size":2,"msg":"sysex"},{"id":78,"pPos":0,"byte":78,"bPos":0,"size":3,"msg":"sysex"},{"id":50,"pPos":0,"byte":50,"bPos":0,"size":7,"msg":"sysex"},{"id":51,"pPos":0,"byte":51,"bPos":0,"size":7,"msg":"sysex"},{"id":52,"pPos":0,"byte":52,"bPos":0,"size":7,"msg":"sysex"},{"id":53,"pPos":0,"byte":53,"bPos":0,"size":2,"msg":"sysex"},{"id":54,"pPos":0,"byte":54,"bPos":0,"size":2,"msg":"sysex"},{"id":55,"pPos":0,"byte":55,"bPos":0,"size":3,"msg":"sysex"},{"id":56,"pPos":0,"byte":56,"bPos":0,"size":2,"msg":"sysex"},{"id":57,"pPos":0,"byte":57,"bPos":0,"size":3,"msg":"sysex"},{"id":29,"pPos":0,"byte":29,"bPos":0,"size":7,"msg":"sysex"},{"id":30,"pPos":0,"byte":30,"bPos":0,"size":7,"msg":"sysex"},{"id":31,"pPos":0,"byte":31,"bPos":0,"size":7,"msg":"sysex"},{"id":32,"pPos":0,"byte":32,"bPos":0,"size":2,"msg":"sysex"},{"id":33,"pPos":0,"byte":33,"bPos":0,"size":2,"msg":"sysex"},{"id":34,"pPos":0,"byte":34,"bPos":0,"size":3,"msg":"sysex"},{"id":35,"pPos":0,"byte":35,"bPos":0,"size":2,"msg":"sysex"},{"id":36,"pPos":0,"byte":36,"bPos":0,"size":3,"msg":"sysex"},{"id":8,"pPos":0,"byte":8,"bPos":0,"size":7,"msg":"sysex"},{"id":9,"pPos":0,"byte":9,"bPos":0,"size":7,"msg":"sysex"},{"id":10,"pPos":0,"byte":10,"bPos":0,"size":7,"msg":"sysex"},{"id":11,"pPos":0,"byte":11,"bPos":0,"size":2,"msg":"sysex"},{"id":12,"pPos":0,"byte":12,"bPos":0,"size":2,"msg":"sysex"},{"id":13,"pPos":0,"byte":13,"bPos":0,"size":3,"msg":"sysex"},{"id":14,"pPos":0,"byte":14,"bPos":0,"size":2,"msg":"sysex"},{"id":15,"pPos":0,"byte":15,"bPos":0,"size":3,"msg":"sysex"},{"id":105,"pPos":0,"byte":105,"bPos":0,"size":7,"msg":"sysex"},{"id":106,"pPos":0,"byte":106,"bPo